{
  "name": "@xp266/dshtui",
  "version": "0.1.29",
  "type": "module",
  "description": "ink-based terminal UI plugin for DeepSeek Harness",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "tui",
    "terminal",
    "ink",
    "plugin"
  ],
  "homepage": "https://github.com/xp266/dsh-tui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xp266/dsh-tui.git"
  },
  "bugs": {
    "url": "https://github.com/xp266/dsh-tui/issues"
  },
  "author": "xp266",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "bin": {
    "dshtui": "./bin/dshtui.js"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run verify:contract && pnpm run verify:manifest && pnpm run verify:package",
    "verify:contract": "node --import tsx/esm scripts/verify-contract.ts",
    "verify:manifest": "node --import tsx/esm scripts/verify-manifest.ts",
    "verify:package": "node scripts/verify-package.mjs",
    "update-capabilities": "node --import tsx/esm scripts/update-capabilities.ts",
    "preversion": "pnpm run update-capabilities && git add src/chat/model-capabilities.ts && pnpm run verify",
    "prepare": "tsdown"
  },
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./contract": {
      "types": "./lib/contract/index.d.mts",
      "default": "./lib/contract/index.mjs"
    },
    "./vendor": {
      "types": "./lib/vendor.d.mts",
      "default": "./lib/vendor.mjs"
    },
    "./dialog": {
      "types": "./lib/dialog.d.mts",
      "default": "./lib/dialog.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "src",
    "cordis.patch.yml",
    "docs/main_logo.jpg",
    "docs/plugin-author-guide.md",
    "docs/plugin-author-guide.zh.md"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-agent-loop": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-attachment": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-credentials": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-default-model": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-loop": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent-presets": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {
    "chalk": "5.6.2",
    "ink": "^7.1.1",
    "marked": "^18.0.10",
    "prismjs": "^1.30.0",
    "react": "^19.2.0",
    "string-width": "^8.2.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.5-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-todo": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^24.0.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
